# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# Gemini (aistudio.google.com/apikey). gemini-flash-latest always tracks
# Google's current default free-tier flash model.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Evolution API instance (self-hosted WhatsApp gateway)
EVOLUTION_API_URL=https://your-evolution-api-instance.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=your-instance-name
